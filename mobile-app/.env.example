# Mobile App Environment Variables
# Dùng với flag: flutter run --dart-define-from-file=.env
API_BASE_URL=http://localhost:8000/api
CONNECT_TIMEOUT_SECONDS=15
RECEIVE_TIMEOUT_SECONDS=15

# Goong Maps Configuration (Lấy tại https://account.goong.io/keys)
GOONG_API_KEY=your_goong_api_key_here
GOONG_MAP_KEY=your_goong_map_key_here
