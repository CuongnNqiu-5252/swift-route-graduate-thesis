# --- CẤU HÌNH BẢO MẬT BẮT BUỘC TRONG MÔI TRƯỜNG DỰ ÁN ---
# Chữ ký bí mật để ký và giải mã Token JWT. Cần phải đủ dài và phức tạp.
JWT_SECRET=your_jwt_secret_key_here_must_be_at_least_32_bytes_long

# --- CẤU HÌNH DATABASE POSTGRES ---
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here

# Tenant workflow: generate a random private shared service credential (Auth/Order/Driver/Routing).
TENANT_INTERNAL_KEY=
WEB_APP_URL=http://localhost:3000
# Local gateway target for in-app dispatch notifications (Compose sets its internal URL).
NOTIFICATION_SERVICE_URL=http://localhost:8086
# Gmail SMTP delivery. Use a Google App Password, never your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=your-google-account@gmail.com
SMTP_USERNAME=your-google-account@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_AUTH=true
SMTP_STARTTLS=true
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# --- CẤU HÌNH CLOUDINARY (Upload ảnh chụp POD, bằng chứng sự cố, biên bản bàn giao) ---
# Điền tài khoản Cloudinary của bạn (nếu để trống, hệ thống sẽ tự động dùng URL demo dự phòng)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# One-time legacy DB adoption only, after confirming schema and a restorable backup:
# SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
# AUTH_FLYWAY_BASELINE_VERSION=4
# ORDER_FLYWAY_BASELINE_VERSION=9
# Remove the baseline-on-migrate override after adoption. Clean DBs run all migrations normally.

# Goong Maps Routing & Distance Matrix
GOONG_API_KEY=
GOONG_BASE_URL=https://rsapi.goong.io
